# DestinIA — variables d'environnement (modèle).
# Copier ce fichier en .env.local et y coller les vraies valeurs.
# .env.local est gitignoré : aucune clé n'est jamais committée ni exposée au client.

# Clé API Replicate (génération d'images). Obtenir le token sur :
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Côté serveur (sensibles, jamais exposés au client) :
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Côté client (préfixe VITE_ = injecté dans le bundle navigateur — clés publiques) :
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Stripe (paiements) ──────────────────────────────────────────────────────────
# Clé secrète (serveur). Utiliser une clé TEST « sk_test_… » en développement :
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Secret de signature du webhook « whsec_… ». En dev :
# stripe listen --forward-to localhost:5180/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=
# Clé publishable (optionnelle — non requise avec la redirection Checkout hébergée) :
VITE_STRIPE_PUBLISHABLE_KEY=
